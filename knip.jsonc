{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.mjs",
    "scripts/demo-video/*.mjs",
    "tests/**/*.ts",
    // Playwright injects it by path (playwright.config.ts, stylePath).
    "tests/visual/stable.css"
  ],
  "project": ["**/*.{ts,tsx,mjs,css}"],
  "ignore": ["scripts/demo-video/repo/**"],
  // The desk foundation's API (foundation.md): exported for the section
  // ports that build on it, some not used by the hero yet.
  "ignoreIssues": {
    "components/landing/desk/**": ["exports"],
    "lib/landing/ink/**": ["exports"]
  },
  // scripts/subset-mono.py cuts the site's code face from Maple Mono's files by path.
  "ignoreDependencies": ["@fontsource/maple-mono"],
  // Rendering the optional demo video needs ffmpeg on the machine.
  "ignoreBinaries": ["ffmpeg"]
}
