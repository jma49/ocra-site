{
  "name": "ocra-site",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "sync-manual": "node scripts/sync-manual.mjs",
    "predev": "npm run sync-manual",
    "dev": "next dev",
    "prebuild": "npm run sync-manual",
    "build": "next build",
    "start": "next start",
    "check": "biome check --error-on-warnings && node scripts/check-colors.mjs && node scripts/check-agents.mjs && knip && npm test",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/*.test.mjs",
    "format": "biome check --write",
    "typecheck": "next typegen && tsc --noEmit",
    "check:schemas": "node scripts/check-schemas.mjs",
    "check:glyphs": "node scripts/check-mono-glyphs.mjs",
    "verify": "npm run check && npm run build && npm run typecheck && npm run check:schemas && npm run check:glyphs",
    "visual:baseline": "playwright test --update-snapshots=all",
    "visual": "playwright test",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@fontsource/maple-mono": "5.3.0",
    "@fumadocs/base-ui": "16.17.5",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "lucide-react": "1.59.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "knip": "6.42.0",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
