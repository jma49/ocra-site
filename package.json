{
  "name": "ocra-site",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "sync-manual": "node scripts/sync-manual.mjs",
    "predev": "npm run sync-manual",
    "dev": "next dev",
    "prebuild": "npm run sync-manual",
    "build": "next build",
    "start": "next start",
    "check": "biome check --error-on-warnings && node scripts/check-colors.mjs && knip",
    "format": "biome check --write",
    "typecheck": "next typegen && tsc --noEmit",
    "check:schemas": "node scripts/check-schemas.mjs",
    "verify": "npm run check && npm run build && npm run typecheck && npm run check:schemas",
    "visual:baseline": "playwright test --update-snapshots=all",
    "visual": "playwright test",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@fontsource/maple-mono": "5.3.0",
    "fumadocs-core": "16.15.17",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.15",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shaders": "4.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "knip": "6.39.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
